# Copy to .env.local. Never commit real secrets. Validated in src/infrastructure/env.ts.

DATABASE_URL=postgres://contextlayer:contextlayer@localhost:5434/contextlayer
BETTER_AUTH_SECRET=        # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
ENCRYPTION_KEY=            # openssl rand -base64 32 (encrypts stored integration tokens)

# AI provider. Either an OpenAI-compatible endpoint (free tiers: Google AI Studio,
# Groq, OpenRouter, local Ollama) or the Vercel AI Gateway when AI_BASE_URL is unset.
AI_BASE_URL=
AI_API_KEY=
# AI_STRUCTURED_OUTPUTS=false   # for endpoints without json_schema support (e.g. DeepSeek)
AI_MODEL=gemini-2.5-flash
# AI_GATEWAY_API_KEY=      # only used when AI_BASE_URL is unset

# GitHub App (see docs/engineering/integrations-setup.md)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=    # PEM, newlines as \n

# Atlassian OAuth 2.0 (3LO) app
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
