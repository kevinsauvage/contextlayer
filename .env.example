# Run `pnpm setup` to create .env.local from this file with the two secrets generated.
# Validated in src/infrastructure/env.ts; a blank value counts as unset. Never commit real secrets.

# --- App ---
DATABASE_URL=postgres://contextlayer:contextlayer@localhost:5434/contextlayer
BETTER_AUTH_SECRET=        # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
ENCRYPTION_KEY=            # openssl rand -base64 32 (encrypts stored integration tokens)

# --- AI (docs/engineering/integrations-setup.md#ai) ---
# Default: Vercel AI Gateway. Set AI_GATEWAY_API_KEY and a "provider/model" id.
AI_MODEL=anthropic/claude-sonnet-5.5
AI_GATEWAY_API_KEY=
# Alternative: any OpenAI-compatible endpoint. Set all three; AI_MODEL is then that provider's model id.
AI_BASE_URL=
AI_API_KEY=
# false for endpoints that reject response_format json_schema (e.g. DeepSeek).
AI_STRUCTURED_OUTPUTS=true
# Optional: a separate model (and endpoint) for the evaluation judge. Empty = reuse AI_MODEL.
# Set AI_JUDGE_MODEL to a different model so the judge does not grade its own output (`pnpm eval`).
AI_JUDGE_MODEL=
AI_JUDGE_BASE_URL=
AI_JUDGE_API_KEY=
AI_JUDGE_STRUCTURED_OUTPUTS=

# --- GitHub App (docs/engineering/integrations-setup.md#github-app) ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=    # PEM, newlines as \n

# --- Atlassian OAuth 2.0 (3LO) app (docs/engineering/integrations-setup.md#atlassian-jira-cloud-oauth-20-3lo) ---
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
