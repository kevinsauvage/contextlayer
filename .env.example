# Copy to .env.local. Never commit real secrets. Validated in src/infrastructure/env.ts.

DATABASE_URL=postgres://contextlayer:contextlayer@localhost:5434/contextlayer
BETTER_AUTH_SECRET=        # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
ENCRYPTION_KEY=            # openssl rand -base64 32 (encrypts stored integration tokens)

# Vercel AI Gateway (read directly by the AI SDK) and the provider/model it routes to
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-sonnet-5.5

# GitHub App (see docs/engineering/integrations-setup.md)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=    # PEM, newlines as \n

# Atlassian OAuth 2.0 (3LO) app
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
